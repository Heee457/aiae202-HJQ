# ---------------------------------------------------------------------------
# Model endpoint (required by every lesson)
# Any OpenAI-compatible Chat Completions endpoint that supports tool calling.
# Run `python scripts/check_endpoint.py` after editing this file.
# ---------------------------------------------------------------------------
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-v4-pro"
# Provider-specific request options as a JSON object, passed as extra_body on every
# chat completion. DeepSeek's thinking models reject forced tool calls (which
# structured output needs), so thinking is turned off by default. Leave empty for
# providers that do not accept unknown fields (OpenAI, Ollama, vLLM).
LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'

# Other providers (replace the three values above):
#   OpenAI    LLM_BASE_URL="https://api.openai.com/v1"        LLM_MODEL="gpt-5-mini"
#   MiniMax   LLM_BASE_URL="https://api.minimax.io/v1"        LLM_MODEL="MiniMax-M3"
#   Ollama    LLM_BASE_URL="http://localhost:11434/v1"        LLM_MODEL="qwen3:8b"     LLM_API_KEY="ollama"
#   vLLM      LLM_BASE_URL="http://localhost:8000/v1"         LLM_MODEL="<served model name>"
#   Zhipu GLM  LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"  LLM_MODEL="glm-5.3-flash"

# ---------------------------------------------------------------------------
# Lesson 16 — cost-aware model routing (optional; both default to LLM_MODEL)
# ---------------------------------------------------------------------------
LLM_SMALL_MODEL=""
LLM_LARGE_MODEL=""

# ---------------------------------------------------------------------------
# Lessons 10 and 15 — vision model (optional)
# Lesson 10's expense demo and lesson 15's browser agent send images to this
# model. DeepSeek serves one on the same endpoint, so the defaults work with
# LLM_API_KEY alone. Any other endpoint with image input works too (e.g. OpenAI
# gpt-5-mini or an OpenAI-compatible Qwen-VL deployment); Zhipu's glm-4.5v on the
# same base URL as above is a verified alternative. Clear VISION_MODEL to run
# the text-only paths of those lessons instead.
# ---------------------------------------------------------------------------
VISION_BASE_URL="https://api.deepseek.com/v1"
# Leave empty to reuse LLM_API_KEY.
VISION_API_KEY=""
VISION_MODEL="deepseek-v4-flash-vision-exp"

# ---------------------------------------------------------------------------
# Lesson 17 — local agent (Ollama)
# ---------------------------------------------------------------------------
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="qwen3:8b"
# Command that starts the MCP filesystem server used in lesson 17
LOCAL_MCP_COMMAND="npx -y @modelcontextprotocol/server-filesystem ."
